# Network: testnet (default) or mainnet. Mainnet also needs NEXT_PUBLIC_RPC_URL and a filled
# src/contracts/deployments.mainnet.json (NET=mainnet ./scripts/deploy.sh).
NEXT_PUBLIC_NETWORK=testnet
# Optional on testnet (default https://soroban-testnet.stellar.org); required on mainnet.
NEXT_PUBLIC_RPC_URL=
# Public origin of the app, for share cards and the Telegram bot's links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cavos (optional). Without it the app offers only Freighter / Stellar wallets.
# Dashboard → App → Settings → Allowed web origins must include http://localhost:3000
NEXT_PUBLIC_CAVOS_APP_ID=
# Cavos console environment: production (default) or development
NEXT_PUBLIC_CAVOS_ENV=production

# Testnet faucet treasury (server only). Stock it with ./scripts/etherfuse-onramp.sh garfio-faucet 500 <orders> <BOND>
FAUCET_SECRET=

# Mercury (server only): full trade history. Free Dev tier on testnet: docs.mercurydata.app
# Without it the app reads the public RPC, which keeps about 7 days of events.
MERCURY_JWT=
# Any random string: Mercury signs the create/graduate webhooks with it (./scripts/telegram-setup.sh).
MERCURY_WEBHOOK_SECRET=

# Telegram bot (server only), from @BotFather. The channel gets the create/graduate alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
